# Copy to .env and fill in. Never commit .env.
# Real values live in Netlify's env UI and a shared password manager — not in chat.

# --- Supabase ---------------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
#
# SERVICE_ROLE bypasses Row Level Security and is a full-access key.
# It is NOT prefixed NEXT_PUBLIC_ and must never appear in a client component.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Only needed for `npm run db:types`
SUPABASE_PROJECT_ID=""

# --- Cloudinary -------------------------------------------------------------
# API secret is server-only. Anything NEXT_PUBLIC_ ships to the browser.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Email (Gmail SMTP) -----------------------------------------------------
# 16-character App Password, NOT the account password.
# Requires 2FA on the account: myaccount.google.com -> Security -> App passwords
GMAIL_USER="community.s4ds@somaiya.edu"
GMAIL_APP_PASSWORD=""
EMAIL_FROM="S4DS KJSIT <community.s4ds@somaiya.edu>"

# --- Secrets ----------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
CRON_SECRET=""

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Seed -------------------------------------------------------------------
# The OWNER account created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@s4ds.local"
SEED_ADMIN_PASSWORD="changeme123"
